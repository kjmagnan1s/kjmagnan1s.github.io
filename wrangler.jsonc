{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kevinjmagnan-com",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "716729a7277f99da0b33538c0d62ffd0",

  // workers.dev only for now. The custom domain gets attached at DNS cutover,
  // after GitHub Pages and Netlify are turned off. See Docs/cloudflare-migration.md.
  "workers_dev": true,

  // Jekyll writes the whole site into _site. `_redirects` and `_headers` are
  // read by the assets layer. 404-page serves the site's own 404.html for
  // unmatched paths. run_worker_first keeps the Worker out of the way of every
  // other static request: it runs for /api/*, for /c/*, and for / (Markdown
  // negotiation and Link headers, see src/worker/markdown.ts), and index.ts falls
  // back to ASSETS for the static JSON files that also live under /api/.
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/api/*", "/c/*"]
  },

  // Plunk project "kevinjmagnan.com" for the kit, the pop-up, and new-page
  // emails (moved from Beehiiv 2026-10-27). PLUNK_FROM must be on a domain
  // verified in that project. PLUNK_SECRET_KEY is set with `wrangler secret put`.
  "vars": {
    "PLUNK_FROM": "kevin@kevinjmagnan.com",
    "PLUNK_FROM_NAME": "Kevin Magnan",
    "PLUNK_REPLY_TO": "kevinjmagnan@gmail.com"
  },

  // Workers AI. The compose agent runs typesafe/jev through this.
  "ai": {
    "binding": "AI"
  },

  // Per-IP rate limits. The Rate Limiting binding only accepts a period of
  // 10 or 60 seconds, so the old Upstash window of 10 requests per 5 minutes
  // is not expressible. 2 per 60s holds the same long-run average with a
  // tighter burst allowance.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "COMPOSE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "SUBSCRIBE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      // Home page playground. One Jev call per try, and visitors click
      // through the example chips, so this allows more than /api/compose.
      "name": "PLAY_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
