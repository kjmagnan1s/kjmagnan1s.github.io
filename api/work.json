---
layout: null
permalink: /api/work.json
---
{% assign d = site.data.site %}
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": "{{ site.url }}/#work",
  "name": "Kevin Magnan - Selected Work",
  "description": "Portfolio of projects and case studies",
  "itemListElement": [
    {% for p in d.projects %}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "item": {
        "@type": "CreativeWork",
        "@id": "{{ site.url }}{{ p.url }}",
        "identifier": "{{ p.id }}",
        "name": "{{ p.name }}",
        "description": "{{ p.summary | escape }}",
        "genre": "{{ p.type }}",
        "about": {{ p.tags | jsonify }},
        "url": "{{ site.url }}{{ p.url }}",
        "author": {
          "@id": "{{ d.person.url }}#me"
        }
      }
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "lastModified": "{{ site.time | date_to_xmlschema }}"
}
